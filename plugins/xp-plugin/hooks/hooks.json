{
  "description": "xp-plugin lane-keeping: state injection at session start (advisory gates land in later stories)",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/session_start.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
